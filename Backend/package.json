{
  "name": "nsxfonio-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/auth.js && node --check src/db/index.js && node --check src/db/schema.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "mkdir -p data && drizzle-kit migrate",
    "auth:generate": "auth generate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.0",
    "better-auth": "^1.6.0",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "nodemon": "^3.1.0"
  }
}
