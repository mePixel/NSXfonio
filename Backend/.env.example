NODE_ENV=development
PORT=3005
HOST=127.0.0.1

# Better Auth needs a stable high-entropy secret with at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3005
# Production:
# BETTER_AUTH_URL=https://api-nsxfonio.xaxa.at

# Comma-separated list of frontend origins allowed to send cookie credentials.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://nsxfonio.xaxa.at

# Google OAuth credentials from Google Cloud Console.
# Authorized redirect URI: http://localhost:3005/api/auth/callback/google
# Production authorized redirect URI: https://api-nsxfonio.xaxa.at/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Matches docker-compose.yml.
DATABASE_URL=postgres://nsxfonio:nsxfonio@localhost:5432/nsxfonio
