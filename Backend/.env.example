NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Better Auth needs a stable high-entropy secret with at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3005

# Comma-separated list of frontend origins allowed to send cookie credentials.
CLIENT_ORIGIN=http://localhost:3000

# Google OAuth credentials from Google Cloud Console.
# Authorized redirect URI: http://localhost:3005/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local SQLite file. Use a libSQL/Postgres setup later if deployment needs it.
DATABASE_URL=./data/auth.sqlite
